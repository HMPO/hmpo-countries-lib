{
  "name": "hmpo-countries-lib",
  "version": "8.0.0",
  "description": "Country lists",
  "main": "./lib/index.js",
  "scripts": {
    "pretest": "npm run lint",
    "test": "npm run unit",
    "posttest": "npm run check-coverage && npm audit --omit=dev",
    "lint": "eslint .",
    "unit": "nyc --reporter=lcov --reporter=text-summary _mocha test --recursive",
    "check-coverage": "nyc check-coverage",
    "prepare": "husky",
    "documentation": "documentation build lib/index.js -f md -o API_DOCS.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UKHomeOffice/passports-countries-lib.git"
  },
  "author": "HMPO",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "bugs": {
    "url": "https://github.com/UKHomeOffice/passports-countries-lib/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/passports-countries-lib",
  "dependencies": {
    "debug": "4.3.7",
    "hmpo-cached-model": "file:~/HMPO_Dev/open-source/hmpo-cached-model/hmpo-cached-model-7.0.0.tgz",
    "underscore": "^1.13.7"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "documentation": "^14.0.3",
    "eslint": "^9.12.0",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "mocha": "^11.3.0",
    "nyc": "^17.1.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.2",
    "sinon-chai": "^3.7.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.4"
  },
  "nyc": {
    "all": true,
    "exclude": [
      "coverage/**",
      "lib/muted-cached-model.js",
      "test/**",
      "eslint.config.js"
    ],
    "lines": 100,
    "branches": 100,
    "functions": 100,
    "statements": 100
  }
}
